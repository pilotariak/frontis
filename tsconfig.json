{
  "compilerOptions": {
    // Every entry point in this repo is bundled by wrangler/esbuild (Workers)
    // or executed directly by bun (scripts): extensionless relative imports,
    // JSON imports and `import.meta` are all fine, so type-check as a bundler
    // target rather than as Node ESM output.
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    // Config for the ghcr.io/graphql-hive/gateway Docker image (see
    // docker-compose.yaml). Its dependencies ship inside that image and are
    // not installed in this workspace, so it cannot be type-checked here.
    "gateway/gateway.config.ts"
  ]
}
