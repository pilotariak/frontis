{
  "name": "frontis",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "database",
    "gateway",
    "subgraphs/*",
    "workers/*"
  ],
  "scripts": {
    "compose": "bun run subgraphs/compose.ts",
    "compose:workers": "WORKERS_SUBDOMAIN=${WORKERS_SUBDOMAIN} bun run subgraphs/compose.ts",
    "dev": "concurrently --names gateway,echo,clubs,competitions -c cyan,blue,green,yellow \"bun run --filter gateway dev\" \"bun run --filter echo dev\" \"bun run --filter clubs dev\" \"bun run --filter competitions dev\"",
    "migrate:local": "bun run --filter database migrate:local",
    "migrate:remote": "bun run --filter database migrate:remote",
    "migrate:list": "bun run --filter database migrate:list",
    "deploy": "bun run compose:workers && bun run --filter echo deploy && bun run --filter clubs deploy && bun run --filter competitions deploy && bun run --filter gateway deploy",
    "scheduler:local": "bun run --filter scheduler dev",
    "scheduler:remote": "bun run --filter scheduler dev --remote",
    "scheduler:deploy": "bun run --filter scheduler deploy",
    "graphql:gateway:local": "bun run --filter gateway dev",
    "graphql:echo:local": "bun run --filter echo dev",
    "graphql:clubs:local": "bun run --filter clubs dev",
    "graphql:clubs:remote": "bun run --filter clubs dev --remote",
    "graphql:competitions:local": "bun run --filter competitions dev",
    "graphql:competitions:remote": "bun run --filter competitions dev --remote"
  },
  "devDependencies": {
    "@theguild/federation-composition": "^0.18.0",
    "concurrently": "^9.0.0",
    "graphql": "^16.9.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.72.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}
