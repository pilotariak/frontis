{
  "name": "frontis",
  "version": "0.5.0",
  "private": true,
  "workspaces": [
    "database",
    "gateway",
    "subgraphs/*",
    "workers/*"
  ],
  "scripts": {
    "compose": "bun run subgraphs/compose.ts",
    "compose:workers": "WORKERS_SUBDOMAIN=${WORKERS_SUBDOMAIN} bun run subgraphs/compose.ts",
    "dev": "concurrently --names gateway,echo,specialties,clubs,competitions,categories,results -c cyan,blue,magenta,green,yellow,white,red \"bun run --filter gateway dev\" \"bun run --filter echo dev\" \"bun run --filter specialties dev\" \"bun run --filter clubs dev\" \"bun run --filter competitions dev\" \"bun run --filter categories dev\" \"bun run --filter results dev\"",
    "migrate:local": "bun run --filter database migrate:local",
    "migrate:remote": "bun run --filter database migrate:remote",
    "migrate:list": "bun run --filter database migrate:list",
    "db:reset:lcapb:local": "bun run --filter database db:reset:lcapb:local",
    "db:reset:lcapb:remote": "bun run --filter database db:reset:lcapb:remote",
    "db:reset:lidfpb:local": "bun run --filter database db:reset:lidfpb:local",
    "db:reset:lidfpb:remote": "bun run --filter database db:reset:lidfpb:remote",
    "db:reset:ctpb:local": "bun run --filter database db:reset:ctpb:local",
    "db:reset:ctpb:remote": "bun run --filter database db:reset:ctpb:remote",
    "db:lcapb:local": "bun run --filter database db:lcapb:local",
    "db:lidfpb:local": "bun run --filter database db:lidfpb:local",
    "db:ctpb:local": "bun run --filter database db:ctpb:local",
    "deploy": "bun run compose:workers && bun run --filter echo deploy && bun run --filter specialties deploy && bun run --filter clubs deploy && bun run --filter competitions deploy && bun run --filter categories deploy && bun run --filter results deploy && bun run --filter gateway deploy",
    "scheduler:local": "bun run --filter scheduler dev",
    "scheduler:remote": "bun run --filter scheduler dev --remote",
    "scheduler:deploy": "bun run --filter scheduler deploy",
    "setup-league:local": "bun run --filter setup-league dev",
    "setup-league:remote": "bun run --filter setup-league dev --remote",
    "setup-league:deploy": "bun run --filter setup-league deploy",
    "graphql:gateway:local": "bun run --filter gateway dev",
    "graphql:gateway:remote": "bun run --filter gateway dev --remote",
    "graphql:echo:local": "bun run --filter echo dev",
    "graphql:specialties:local": "bun run --filter specialties dev",
    "graphql:specialties:remote": "bun run --filter specialties dev --remote",
    "graphql:clubs:local": "bun run --filter clubs dev",
    "graphql:clubs:remote": "bun run --filter clubs dev --remote",
    "graphql:competitions:local": "bun run --filter competitions dev",
    "graphql:competitions:remote": "bun run --filter competitions dev --remote",
    "graphql:categories:local": "bun run --filter categories dev",
    "graphql:categories:remote": "bun run --filter categories dev --remote",
    "graphql:results:local": "bun run --filter results dev",
    "graphql:results:remote": "bun run --filter results dev --remote"
  },
  "devDependencies": {
    "@theguild/federation-composition": "^0.18.0",
    "concurrently": "^9.0.0",
    "graphql": "^16.9.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.72.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "cf": "^0.0.5",
    "cheerio": "^1.2.0"
  }
}
